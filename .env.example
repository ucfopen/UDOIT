# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

### REQUIRED CONFIGURATION ###
JWK_BASE_URL="https://example.instructure.com/"     # Your Canvas URL. Include https and trailing slash.
APP_SECRET="secretGoesHere"                         # Any unique and random 32-character string, like one from random.org.

### DEPLOYMENT-SPECIFIC CONFIGURATION ###
# Note: If you are developing using Docker, the default values create a working deployment.
APP_ENV="prod"                                      # APP_ENV can be 'prod' or 'dev'
BASE_URL="https://localhost/udoit"                  # Include https:// but not a trailing slash '/'
WEBPACK_PUBLIC_PATH="/udoit/build"                  # Where the built project is hosted relative to the server's root.
DATABASE_URL="mysql://root:root@db:3306/udoit"      # Can be mysql, SQLite, or PostgreSQL, see below.
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# For a PostgreSQL database, use: "postgresql://db_user:db_password@127.0.0.1:5432/db_name?serverVersion=11&charset=utf8"
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml

### Institution Default Preferences ###
DEFAULT_LANG="en"                 # 'en' for English and 'es' for Spanish
DATE_FORMAT="Y-m-d"               # Many valid formats. See https://www.php.net/manual/en/datetime.format.php.
BACKGROUND_COLOR="#ffffff"      # The default background color of Canvas pages
TEXT_COLOR="#273540"            # The default text color of Canvas pages

### LTI Connection Defaults ###
APP_LMS="canvas"
APP_OAUTH_REDIRECT_PATH="/authorize/check"
APP_LTI_REDIRECT_PATH="/lti/authorize/check"
APP_LTI_NAME="UDOIT"
ADMIN_LTI_NAME="UDOIT Admin"

# Enable Sentry DSN for built-in error tracking. See https://sentry.io/welcome/
SENTRY_DSN=""
SENTRY_ENV="dev"