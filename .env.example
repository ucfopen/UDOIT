# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

# APP_ENV can be 'prod' or 'dev'
# APP_SECRET can be any unique and random 32-character string, like one from random.org.
APP_ENV="prod"
APP_SECRET="secretGoesHere"

# Add a Sentry DSN for built-in error tracking. See https://sentry.io/welcome/
SENTRY_DSN=""
SENTRY_ENV="dev"

### Database Connection ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# For a PostgreSQL database, use: "postgresql://db_user:db_password@127.0.0.1:5432/db_name?serverVersion=11&charset=utf8"
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
DATABASE_URL="mysql://root:root@db:3306/udoit3"
MESSENGER_TRANSPORT_DSN="doctrine://default"

### UDOIT LTI and API Configuration ###
APP_LMS="canvas"
APP_OAUTH_REDIRECT_PATH="/authorize/check"
APP_LTI_REDIRECT_PATH="/lti/authorize/check"
APP_LTI_NAME="UDOIT 4"
ADMIN_LTI_NAME="UDOIT 4 Admin"
USE_DEVELOPMENT_AUTH="no"
VERSION_NUMBER="4.0.0"
JWK_BASE_URL="https://example.instructure.com/" # Include https and trailing slash.
BASE_URL="https://localhost/udoit3"
WEBPACK_PUBLIC_PATH="/udoit3/build"

### Admin Panel Data Retrieval Parameters ###
ADMIN_RETRIEVAL_LMS_DOMAIN="example.instructure.com" # No https or trailing slash.
ADMIN_RETRIEVAL_API_TOKEN="tokenGoesHere"
ADMIN_PANEL_INSTITUTION_ID=1

### Default Preferences ###
DEFAULT_LANG="en"
DATE_FORMAT="Y-m-d"
BACKGROUND_COLOR="#ffffff"
TEXT_COLOR="#273540"